{
  "name": "@cobeo2004/edge",
  "version": "0.0.9",
  "description": "Deno Edge Runtime for Node.js, written in TypeScript on top of Deno HTTP Worker",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . && npm run lint:deno-bootstrap && npm run lint:deno-test-files",
    "lint:deno-bootstrap": "cd deno-bootstrap && deno lint",
    "lint:deno-test-files": "cd src/test && deno lint",
    "lint:fix": "biome check . --fix && npm run lint:deno-bootstrap:fix && npm run lint:deno-test-files:fix",
    "lint:deno-bootstrap:fix": "cd deno-bootstrap && deno lint --fix",
    "lint:deno-test-files:fix": "cd src/test && deno lint --fix",
    "build": "tsc --build",
    "prepare": "npm run lint && npm run build"
  },
  "files": [
    "dist",
    "deno-bootstrap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobeo2004/edge.git"
  },
  "type": "module",
  "engines": {
    "node": "20 || 22 || 24"
  },
  "author": "Val Town (@val-town) & Simon Nguyen (@cobeo2004)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cobeo2004/edge/issues"
  },
  "homepage": "https://github.com/cobeo2004/edge#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.4.5",
    "vitest": "^3",
    "ws": "^8.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jose": "^6.2.1"
  }
}
